+def game_uid(payload):
+    if not isinstance(payload, dict):
+        return ""
+    doc = payload.get("document") or payload.get("actual_inputs") or payload
+    imported = doc.get("account_import", {}) if isinstance(doc, dict) else {}
+    value = payload.get("gameUid") or imported.get("account_id_text") or imported.get("account_id")
+    if not value and (payload.get("kind") == "b25" or isinstance(payload.get("entries"),list)):
+        value = (payload.get("record") or payload.get("card") or payload).get("accountId")
+    if isinstance(value, (int,float)) and (isinstance(value,bool) or abs(value)>9007199254740991):
+        return ""
+    value = str(value or "")
+    return value if re.fullmatch(r"[0-9]{1,30}", value) else ""
 
 
